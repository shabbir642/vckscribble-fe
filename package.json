{
  "name": "vckscribble-fe",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-contract.mjs --check && tsc -b && vite build",
